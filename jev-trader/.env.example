# Copiá este archivo a .env y completá. NUNCA subas .env al repo.

# --- Cerebro: Jev (TypeSafe AI, decisiones rápidas; acceso anticipado en typesafe.ai) ---
TYPESAFE_API_KEY=
JEV_ENGINE=hybrid            # hybrid (reglas + Jev) | jev | rules | claude
JEV_HYBRID_CONFIRMER=jev     # jev | claude
JEV_MODEL=jev-latest
JEV_TIMEOUT_S=3
JEV_MAX_AI_COST_USD_PER_DAY=1.0

# --- Claude (opcional) ---
ANTHROPIC_API_KEY=
JEV_CLAUDE_MODEL=claude-haiku-4-5

# --- Mercado ---
JEV_EXCHANGE=binance
JEV_SYMBOL=BTC/USDT
# Con Jev (hybrid/jev) conviene 1h: en 5m el costo ida y vuelta (~0,3 %) se come el take-profit
# y Jev casi nunca encuentra valor esperado positivo, así que el bot solo espera.
JEV_TIMEFRAME=5m

# --- Modo (paper por defecto) ---
JEV_MODE=paper               # paper | live
JEV_USE_TESTNET=true
# Para dinero real hacen falta las 3 cosas: JEV_MODE=live, JEV_USE_TESTNET=false
# y esta frase exacta:
# JEV_LIVE_CONFIRM=YES_I_ACCEPT_REAL_MONEY_RISK
JEV_API_KEY=
JEV_API_SECRET=
# Live: el bot usa TODO el USDT libre de la cuenta. Para limitarlo (p. ej. 200 USDT + su PnL):
JEV_LIVE_MAX_CAPITAL=

# --- Paper trading ---
JEV_PAPER_START_CASH=1000
JEV_FEE_PCT=0.1
JEV_SLIPPAGE_PCT=0.05

# --- Riesgo ---
JEV_RISK_PER_TRADE_PCT=1.0
JEV_MAX_POSITION_PCT=25
JEV_MAX_DAILY_LOSS_PCT=3
JEV_MAX_DRAWDOWN_PCT=10
JEV_MAX_TRADES_PER_DAY=10
JEV_MIN_CONFIDENCE=0.6
JEV_COOLDOWN_CANDLES=3
JEV_DEFAULT_STOP_PCT=2
JEV_DEFAULT_TAKE_PROFIT_PCT=4
JEV_MIN_ORDER_NOTIONAL=10
JEV_FLATTEN_ON_KILL=true
