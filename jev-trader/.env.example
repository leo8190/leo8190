# Copiá este archivo a .env y completá. NUNCA subas .env al repo.

# --- Claude (decisiones rápidas) ---
ANTHROPIC_API_KEY=
JEV_MODEL=claude-haiku-4-5
JEV_ENGINE=hybrid            # hybrid | claude | rules
JEV_LLM_TIMEOUT_S=8
JEV_MAX_LLM_COST_USD_PER_DAY=1.0

# --- Mercado ---
JEV_EXCHANGE=binance
JEV_SYMBOL=BTC/USDT
JEV_TIMEFRAME=5m

# --- Modo (paper por defecto) ---
JEV_MODE=paper               # paper | live
JEV_USE_TESTNET=true
# Para dinero real hacen falta las 3 cosas: JEV_MODE=live, JEV_USE_TESTNET=false
# y esta frase exacta:
# JEV_LIVE_CONFIRM=YES_I_ACCEPT_REAL_MONEY_RISK
JEV_API_KEY=
JEV_API_SECRET=

# --- Paper trading ---
JEV_PAPER_START_CASH=1000
JEV_FEE_PCT=0.1
JEV_SLIPPAGE_PCT=0.05

# --- Riesgo ---
JEV_RISK_PER_TRADE_PCT=1.0
JEV_MAX_POSITION_PCT=25
JEV_MAX_DAILY_LOSS_PCT=3
JEV_MAX_DRAWDOWN_PCT=10
JEV_MAX_TRADES_PER_DAY=10
JEV_MIN_CONFIDENCE=0.6
JEV_COOLDOWN_CANDLES=3
JEV_DEFAULT_STOP_PCT=2
JEV_DEFAULT_TAKE_PROFIT_PCT=4
JEV_MIN_ORDER_NOTIONAL=10
JEV_FLATTEN_ON_KILL=true
