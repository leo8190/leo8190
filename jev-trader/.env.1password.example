# Referencias propuestas: crear/verificar primero el ítem "Jev Trader" en la bóveda Codex.
# Copiar a .env.1password. Nunca poner valores reales aquí.
# Este perfil sólo necesita la clave de TypeSafe para paper o doctor.
TYPESAFE_API_KEY="op://Codex/Jev Trader/TYPESAFE_API_KEY"
JEV_EXCHANGE=binance
JEV_SYMBOL=BTC/USDT
JEV_TIMEFRAME=1h
JEV_MODEL=jev-latest
JEV_MAX_AI_COST_USD_PER_DAY=1.0
JEV_JOURNAL_PATH=jev_paper_1h.sqlite3
# El lanzador controla modo, testnet y motor. No agregarlos a este archivo.
