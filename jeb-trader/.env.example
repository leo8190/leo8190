# Copiá este archivo a .env y completá. NUNCA subas .env al repo.

# --- Claude (decisiones rápidas) ---
ANTHROPIC_API_KEY=
JEB_MODEL=claude-haiku-4-5
JEB_ENGINE=hybrid            # hybrid | claude | rules
JEB_LLM_TIMEOUT_S=8
JEB_MAX_LLM_COST_USD_PER_DAY=1.0

# --- Mercado ---
JEB_EXCHANGE=binance
JEB_SYMBOL=BTC/USDT
JEB_TIMEFRAME=5m

# --- Modo (paper por defecto) ---
JEB_MODE=paper               # paper | live
JEB_USE_TESTNET=true
# Para dinero real hacen falta las 3 cosas: JEB_MODE=live, JEB_USE_TESTNET=false
# y esta frase exacta:
# JEB_LIVE_CONFIRM=YES_I_ACCEPT_REAL_MONEY_RISK
JEB_API_KEY=
JEB_API_SECRET=

# --- Paper trading ---
JEB_PAPER_START_CASH=1000
JEB_FEE_PCT=0.1
JEB_SLIPPAGE_PCT=0.05

# --- Riesgo ---
JEB_RISK_PER_TRADE_PCT=1.0
JEB_MAX_POSITION_PCT=25
JEB_MAX_DAILY_LOSS_PCT=3
JEB_MAX_DRAWDOWN_PCT=10
JEB_MAX_TRADES_PER_DAY=10
JEB_MIN_CONFIDENCE=0.6
JEB_COOLDOWN_CANDLES=3
JEB_DEFAULT_STOP_PCT=2
JEB_DEFAULT_TAKE_PROFIT_PCT=4
JEB_MIN_ORDER_NOTIONAL=10
JEB_FLATTEN_ON_KILL=true
